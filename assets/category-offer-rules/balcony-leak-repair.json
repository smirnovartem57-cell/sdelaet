            ]
          },
          {
            "field": "goal",
            "containsAny": [
              "конденсат",
              "плесень",
              "влажн"
            ]
          }
        ]
      },
      "requirementLevel": "comparison",
      "clarification": "выполнена ли диагностика причины конденсата / влажности"
    },
    "diagnosticsCost": {
      "requiredRule": false,
      "requirementLevel": "completeness",
      "clarification": "стоимость диагностики отдельной суммой"
    }
  }
