{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onsdelaet.ru/schemas/service-categories.schema.json",
  "title": "Сделает Service Category Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "categories"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "required": [
        "categoryId",
        "serviceCode",
        "title",
        "status",
        "search"
      ],
      "properties": {
        "categoryId": {
          "type": "string",
          "minLength": 2
        },
        "serviceCode": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2
        },
        "seo": {
          "$ref": "#/$defs/seo"
        }
      }
    },
    "seo": {
      "type": "object",
      "required": [
        "indexable",
        "publicationStatus",
        "slug",
        "canonicalPath",
        "contentVersion"
      ],
      "properties": {
        "indexable": {
          "type": "boolean"
        },
        "publicationStatus": {
          "enum": [
            "DRAFT",
            "REVIEW",
            "APPROVED"
          ]
        },
        "slug": {
          "type": "string"
        },
        "canonicalPath": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "h1": {
          "type": "string"
        },
        "primaryIntent": {
          "type": "string"
        },
        "primaryQueries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "informationalQueries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "breadcrumbs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/breadcrumb"
          }
        },
        "infoBlocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/infoBlock"
          }
        },
        "quoteChecklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "costFactors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "faq": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/faq"
          }
        },
        "relatedCategoryIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewedAt": {
          "type": "string"
        },
        "contentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "automation": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "status": {
              "enum": [
                "AUTO_DRAFT",
                "ENRICHED",
                "CURATED"
              ]
            },
            "expertModelUsed": {
              "type": "boolean"
            },
            "needsQueryResearch": {
              "type": "boolean"
            },
            "researchStatus": {
              "enum": [
                "EVIDENCE_REQUIRED",
                "REVIEW_REQUIRED",
                "READY_FOR_REVIEW"
              ]
            }
          }
        },
        "research": {
          "$ref": "#/$defs/seoResearch"
        }
      }
    },
    "breadcrumb": {
      "type": "object",
      "required": [
        "name",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "infoBlock": {
      "type": "object",
      "required": [
        "id",
        "title",
        "shortAnswer",
        "queryCluster",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "shortAnswer": {
          "type": "string"
        },
        "queryCluster": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "faq": {
      "type": "object",
      "required": [
        "question",
        "shortAnswer"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "shortAnswer": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "seoResearch": {
      "type": "object",
      "required": [
        "status",
        "sources",
        "queryCount",
        "evidenceQueryCount",
        "clusters",
        "questions",
        "aiAnswerTargets",
        "cannibalization",
        "researched",
        "researchVersion"
      ],
      "properties": {
        "status": {
          "enum": [
            "EVIDENCE_REQUIRED",
            "REVIEW_REQUIRED",
            "READY_FOR_REVIEW"
          ]
        },
        "collectedAt": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "queryCount": {
          "type": "integer",
          "minimum": 0
        },
        "evidenceQueryCount": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aiAnswerTargets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cannibalization": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "researched": {
          "type": "boolean"
        },
        "reviewedAt": {
          "type": "string"
        },
        "researchVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
